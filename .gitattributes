# Keep repository text files consistent across operating systems.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Preserve image assets byte-for-byte.
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
